{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch npm config set",
            "runtimeExecutable": "npm",
            "args": [
                "config",
                "set",
                "allow-scripts=@opencode/cli",
                "--location=user"
            ],
            "cwd": "${workspaceFolder}/../../..",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}